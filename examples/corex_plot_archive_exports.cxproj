            "script": "exports = input_data or {}\n\ndef ref_text(value):\n    if value is None:\n        return '<missing>'\n    return getattr(value, 'ref', str(value))\n\nstatic_ref = exports.get('static_export') if isinstance(exports, dict) else None\ndata_ref = exports.get('data_export') if isinstance(exports, dict) else None\nstatic_meta = exports.get('static_metadata', {}) if isinstance(exports, dict) else {}\ndata_meta = exports.get('data_metadata', {}) if isinstance(exports, dict) else {}\noutput_data = (\n    'Static export: ' + ref_text(static_ref)\n    + ' | Data export: ' + ref_text(data_ref)\n    + ' | static backend: ' + str(static_meta.get('backend_id', '<unknown>'))\n    + ' | rows: ' + str(((data_meta.get('metadata') or {}).get('row_count', '<unknown>')))\n)\n"
