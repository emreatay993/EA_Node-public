{
  "schema_version": 1,
  "title": "Blade-out secondary ESL - compressor casing rig cases",
  "notes": "SCHEMA TEMPLATE ONLY - the inputs/... paths below are placeholders that do not exist; loading this file in the GUI will flag them red. For a runnable demo use examples/mockup_inputs/mockup_config.json (GUI: 'Load Example' button). JSON has no comments; rationale lives in 'notes' fields. Paths resolve relative to this file's folder.",
  "units": {
    "force": "N",
    "moment": "N.mm",
    "stress": "MPa",
    "length": "mm",
    "note": "Consistency assumed, never validated - stated per methodology section 12."
  },
  "msup": {
    "modal_stress_csv": "inputs/modal_stress_w_coords.csv",
    "modal_coordinates": "inputs/bladeout_secondary.mcf",
    "modal_forces_csv": null,
    "modes_used": null,
    "steady_state_csv": null,
    "include_steady_bias": false
  },
  "target": { "mode": "reconstruct", "tensor_csv": null, "subtract_steady_csv": null },
  "interface_loads_csv": "inputs/interface_history_canonical.csv",
  "rig": {
    "unit_fields": {
      "layout": "wide",
      "csv": "inputs/rig_unit_fields.csv",
      "per_case_files": null,
      "rst": null
    },
    "channels": [
      {
        "name": "P1_fwd_vert",
        "case_label": "Case1",
        "unit_load": 1000.0,
        "point": [120.0, 0.0, 340.0],
        "direction": [0.0, 0.0, -1.0],
        "bounds": [0.0, 80000.0],
        "interface_channel": "Fz_front_mount",
        "apdl_node": 900001,
        "gang": null,
        "gang_ratio": 1.0,
        "notes": "Push-only 8t actuator; capacity from subcontractor datasheet (ESL-3 open item)"
      },
      {
        "name": "P2_fwd_lat",
        "case_label": "Case2",
        "unit_load": 1000.0,
        "point": [120.0, 95.0, 0.0],
        "direction": [0.0, -1.0, 0.0],
        "bounds": [0.0, 50000.0],
        "interface_channel": "Fy_front_mount",
        "apdl_node": 900002,
        "gang": null,
        "gang_ratio": 1.0,
        "notes": "Push-only"
      }
    ]
  },
  "interfaces": [
    {
      "name": "front_mount",
      "node_list_csv": "inputs/front_mount_nodes.csv",
      "ref_point": [120.0, 0.0, 0.0]
    }
  ],
  "mapping": { "coord_tol": 0.1, "kdtree_max_dist": 1.0, "min_id_match_fraction": 0.9 },
  "instants": {
    "mode": "auto",
    "explicit_times": null,
    "n_suggestions": 4,
    "quadrature": true,
    "hotspot_top_percent": 2.0,
    "cluster_dt": 0.002,
    "mars_envelope": {
      "max_vm_csv": "inputs/max_von_mises.csv",
      "time_of_max_vm_csv": "inputs/time_of_max_von_mises.csv"
    }
  },
  "solve": {
    "tier": "both",
    "weighting": "vm",
    "vm_weight_exponent": 1.0,
    "region": { "mode": "top_vm_percent", "value": 5.0, "node_list_csv": null, "bbox": null },
    "tikhonov_alpha": 0.0,
    "cond_warn_threshold": 1e8
  },
  "acceptance": { "under_test_tol": 0.05, "vm_floor_frac": 0.10, "min_peak_ratio": 1.0 },
  "scaling": {
    "rt_factor": 1.0,
    "basis_note": "RT->operating property-ratio factor per projects/compressor-casing-certification.md; scales LOAD in the reported table only, never inside the ESL math."
  },
  "outputs": { "directory": "esl_out", "apdl_snippet": true, "top_n_hotspots": 25 }
}
